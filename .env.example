APP_ENV=local
APP_MODE=paper
LIVE_TRADING_ENABLED=false
CONFIG_VERSION=foundation-v1
# make setup generates local secrets if .env does not exist.
# make setup also creates ignored .env.credentials (0600) for the API-only vault key.
# Keep CREDENTIAL_MASTER_KEY out of this shared .env and out of web/trading.
BACKEND_AUTH_TOKEN=generate-with-make-setup
POSTGRES_DB=ai_futures
POSTGRES_USER=ai_futures
POSTGRES_PASSWORD=generate-with-make-setup
DATABASE_URL=postgresql+asyncpg://ai_futures:generate-with-make-setup@postgres:5432/ai_futures
REDIS_URL=redis://redis:6379/0
API_PORT=8000
WORKER_HEARTBEAT_SECONDS=5
WORKER_STALE_SECONDS=20
# AI remains disabled unless explicitly opted in. Keep the key only in local .env/secret store.
AI_ENABLED=false
# OPENAI_API_KEY=
# Optional alert credentials; credentials alone never enable delivery.
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_CHAT_ID=
TELEGRAM_DELIVERY_ENABLED=false
# Set only after separate approval and a review of the existing outbox.
# Must be a nonfuture UTC ISO 8601 timestamp, for example 2026-10-17T00:00:00Z.
# TELEGRAM_DELIVERY_CUTOFF_UTC=
GDELT_FORWARD_ENABLED=false
GKG_FORWARD_ENABLED=false
# Requires migration d3c7a5e91f02 before enabling; default keeps Paper ingest independent.
MARKET_CANDLE_JOURNAL_ENABLED=false
